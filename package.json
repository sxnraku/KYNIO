  "scripts": {
    "build:android:local-apk": "cmd /c android\\build-apk.bat",
    "build:android:local-aab": "cmd /c android\\build-aab.bat",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "postinstall": "node scripts/patch-metro-config.cjs",
    "start": "expo start",
    "dev": "expo start --web --clear",
    "android": "expo run:android",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "e2e": "maestro test .maestro",
    "e2e:export": "maestro test .maestro/export_data_gdpr.yaml",
    "e2e:onboarding": "maestro test .maestro/onboarding_and_fasting.yaml",
    "e2e:paywall": "maestro test .maestro/paywall_from_meals.yaml",
    "e2e:theme-language": "maestro test .maestro/theme_and_language.yaml",
    "e2e:water": "maestro test .maestro/water_tracking.yaml",
    "e2e:weight": "maestro test .maestro/log_weight.yaml",
    "e2e:workout": "maestro test .maestro/log_manual_workout.yaml",
    "ios": "expo run:ios",
    "test": "jest --runInBand",
    "test:ai-contract": "node scripts/verify-ai-meal-service.cjs",
    "test:legal-site": "node scripts/verify-legal-site.cjs",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "web": "expo start --web",
    "lint": "expo lint",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run test:ai-contract && npm run test:legal-site && npx expo-doctor && npx expo export --platform android --output-dir .expo-export-check",
    "submit:android": "npx eas-cli submit --platform android --profile production",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
