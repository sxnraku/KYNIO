{
  "expo": {
    "name": "KYNIO",
    "slug": "kynio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-kynio-v1.png",
    "scheme": "kynio",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kynio.app",
      "icon": "./assets/images/icon-kynio-v1.png"
    },
    "android": {
      "package": "com.kynio.app",
      "adaptiveIcon": {
        "backgroundColor": "#10B981",
        "foregroundImage": "./assets/images/icon-kynio-v1.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon-kynio-v1.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F6F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite ao KYNIO enquadrar e fotografar a tua refeição.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite ao KYNIO escolher uma fotografia da tua refeição.",
          "cameraPermission": "Permite ao KYNIO fotografar a tua refeição.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "react-native-share",
        {
          "android": [],
          "enableBase64ShareAndroid": false,
          "ios": []
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
